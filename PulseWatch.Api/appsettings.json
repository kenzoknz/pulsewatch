{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UptimeMonitoring": {
    "SchedulerDelaySeconds": 60,
    "HttpTimeoutSeconds": 10,
    "RetentionDays": 90,
    "MaxRetries": 3,
    "UrlSecurity": {
      "MaxUrlLength": 2048,
      "MaxRedirects": 5,
      "MaxResponseBodyBytes": 1048576,
      "DnsResolutionTimeoutSeconds": 5,
      "AllowedPorts": [ 80, 443 ],
      "MaxCustomHeaderCount": 20,
      "MaxCustomHeadersLength": 2048,
      "AllowPrivateNetworks": false,
      "AllowedCustomHeaders": [
        "Accept",
        "Accept-Language",
        "Cache-Control",
        "Content-Type",
        "User-Agent"
      ]
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=KENZO\\SQLEXPRESS;Database=PulseWatchDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PulseWatch",
    "Audience": "PulseWatch.Client",
    "Key": "",
    "ExpiresInMinutes": 60
  },
  "Smtp": {
    "Server": "",
    "Port": "587",
    "Username": "",
    "Password": "",
    "FromAddress": "alerts@pulsewatch.com"
  }
}